#errorCatcher Echo
#encoding UTF-8
#set global $page = "graphs"

    #include "header.html.tmpl"

    <div class="site-inner">
        <main class="content">	
            <article class="weewx graphs" itemscope itemtype="https://schema.org/CreativeWork">

                <script type="text/javascript">
                    var graph = getURLvar("graph");
                    if ( graph === undefined ) {
                        // If no URL VAR, default to the graph group defined in Extras
                        graph = "$Extras.graph_page_default_graphgroup";
                    }
                    var thisPageGraphs = graphgroups_raw[graph];
                    
                    wx_ready(function() {
                        if (graph == "all") { 
                            // Build all graphs
                            var i = 0;
                            for (var graphgroup in graphgroups_raw) {
                                // Rename the graph-outer div to remove CSS
                                wx_all(".graph-outer").forEach(function(el) { el.className = "graph-outer-all"; });
                                
                                var page_content = "";
                                if ( graphpage_content[graphgroup] ) {
                                    page_content = graphpage_content[graphgroup];
                                }
                                
                                // Loop through every graph group defined and add a title section
                                wx_all(".graph-outer-all").forEach(function(el) { el.insertAdjacentHTML("beforeend", '\
                                    <div class="' + graphgroup + '_outer graphgroup-outer">\
                                        <div class="graphpage-title wx-buttons-description">\
                                            <a href="./?graph='+graphgroup+'">'+ graphgroups_titles[graphgroup] +'</a>\
                                        </div>\
                                        <div class="graphpage-content">'+page_content+'</div>\
                                        <div class="' + graphgroup + ' wx-chart-grid"></div>\
                                    </div>\
                                '); });
                                
                                if ( i > 0 ) {
                                    wx_css("." + CSS.escape(graphgroup + "_outer"), "border-top", "1px solid #ccc");
                                }
                                
                                // Within each title section add the chart divs with the graph group prepending to avoid conflicts
                                graphgroups_raw[graphgroup].forEach( graphID => {
                                    wx_all("." + CSS.escape(graphgroup)).forEach(function(el) { el.insertAdjacentHTML("beforeend", '<div class="wx-chart"><div id="' + graphgroup + "_" + graphID + '" style="width:100%;height:100%;margin-top:20px;"></div></div>'); });
                                });
                                
                                // Render the charts with the prepend_renderTo set to true
                                showChart(graphgroup, true);
                                
                                i++;
                            };
                        } else {
                            // Loop through the graph group for this page and add the graph divs to the page
                            try {
                                thisPageGraphs.forEach( graphID => {
                                    wx_all(".graph-outer").forEach(function(el) { el.insertAdjacentHTML("beforeend", '<div class="wx-chart"><div id="' + graphID + '" style="width:100%;height:100%;margin-top:20px;"></div></div>'); });
                                });
                                
                                // Set page title
                                wx_html(".graphpage-title", graphgroups_titles[graph]);
                                
                                // Set page content
                                wx_html(".graphpage-content", graphpage_content[graph]);
                                
                                // Render the charts
                                showChart(graph);
                            } catch(err) {
                                console.log("ERROR: Cannot add graphs from [" + graph + "] graph group: " + err.message);
                            }
                        }
                    });
                </script>
                
                #include "page-header.inc"

                <div class="wx-buttons">
                        #if "graph_page_show_all_button" in $Extras and $Extras.graph_page_show_all_button == '1'
                        <a href="./?graph=all"><button type="button" class="btn btn-primary wx-btn-year">$obs.label.graphs_page_all_button</button></a>
                        #end if
                        $graph_page_buttons
                </div>
                <div class="wx-buttons-description">
                    <span class='graphpage-title'></span>
                </div>

                <div class="graphpage-content"></div><!-- JS populated -->

                <div class="graph-outer wx-chart-grid wx-chart-grid-1"></div><!-- JS populated -->
                
                <div class="clear"></div>
                
            </article>
        </main>
    </div>


    #include "footer.html.tmpl"

