    <div class="site-inner">
        <main class="content">
            <article class="weewx records" itemscope itemtype="https://schema.org/CreativeWork">

                #include "page-header.inc"

                #if os.path.exists("records.inc")
                <div class="wx-records-description">
                    #include "records.inc"
                </div>
                #end if

                <section class="rec-section rec-new">
                    <h2><i class="fa fa-trophy" aria-hidden="true"></i> $obs.label.records_set_this_year $this_year</h2>
                    #if $new_records
                    <div class="rec-new-list">
                        #for $item in $new_records
                        <div class="rec-new-item">
                            <div class="rec-label">$item["label"]</div>
                            <div class="rec-value">$item["a"][0]</div>
                            <div class="rec-date">$when($item["a"])</div>
                        </div>
                        #end for
                    </div>
                    #else
                    <p class="rec-empty">$obs.label.records_none_this_year</p>
                    #end if
                </section>

                #set $otd = $on_this_day
                #if len($otd) > 1
                <section class="rec-section rec-otd" id="on-this-day">
                    <h2><i class="fa fa-calendar" aria-hidden="true"></i> $obs.label.records_on_this_day <time data-ts="$current.dateTime.raw" data-format="time_records_page_rainfall_range_begin"></time></h2>
                    <div class="rec-otd-rows">
                        #for $d in reversed($otd)
                        <div class="rec-otd-row#if $d.today then ' is-today' else ''#">
                            <span class="rec-otd-year">$d.year#if $d.today then '<small>' + $obs.label.records_so_far + '</small>' else ''#</span>
                            <span class="rec-otd-low#if $d.coldest then ' is-record' else ''#"#if $d.coldest then ' title="' + $obs.label.records_coldest + '"' else ''#>$d.low</span>
                            <span class="rec-otd-bar"><span style="left: ${d.bar_left}%; width: ${d.bar_width}%"></span></span>
                            <span class="rec-otd-high#if $d.warmest then ' is-record' else ''#"#if $d.warmest then ' title="' + $obs.label.records_warmest + '"' else ''#>$d.high</span>
                            <span class="rec-otd-rain#if $d.wettest then ' is-record' else ''#"#if $d.wettest then ' title="' + $obs.label.records_wettest + '"' else ''#>#if $d.rain is not None then $d.rain else ''#</span>
                        </div>
                        #end for
                    </div>
                </section>
                #end if

                #for $g in $groups
                <section class="rec-section">
                    <h2><i class="wi $g['icon']" aria-hidden="true"></i> $g["title"]</h2>
                    <div class="rec-grid">
                        #for $item in $g["items"]
                        <div class="rec-card#if $item['new'] then ' is-new' else ''#">
                            <h3 class="rec-label">$item["label"]#if $item["new"]# <i class="fa fa-trophy" aria-hidden="true" title="$obs.label.records_set_this_year $this_year"></i>#end if#</h3>
                            <div class="rec-sides">
                                <div class="rec-side">
                                    <div class="rec-when-label">$this_year</div>
                                    <div class="rec-value"#if $item.get("delta") then ' data-unit-delta' else ''#>$item["y"][0]</div>
                                    <div class="rec-date">$when($item["y"])</div>
                                    #if $item["y"][4]
                                    <div class="rec-note">$item["y"][4]</div>
                                    #end if
                                </div>
                                <div class="rec-side">
                                    <div class="rec-when-label">$obs.label.records_all_time</div>
                                    <div class="rec-value"#if $item.get("delta") then ' data-unit-delta' else ''#>$item["a"][0]</div>
                                    <div class="rec-date">$when($item["a"])</div>
                                    #if $item["a"][4]
                                    <div class="rec-note">$item["a"][4]</div>
                                    #end if
                                </div>
                            </div>
                        </div>
                        #end for
                    </div>
                </section>
                #end for

                #if os.path.exists("records-table.inc")
                <section class="rec-section records-table">
                    <table class="table-striped">
                        <tbody>
                            #include "records-table.inc"
                        </tbody>
                    </table>
                </section>
                #end if
            </article>
        </main>
    </div>
    #include "footer.html.tmpl"
