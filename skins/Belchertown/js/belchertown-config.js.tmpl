var belchertown_config = {
    "belchertown_debug": $belchertown_debug,
    "system_locale_js": $json.dumps(str($system_locale_js)),
    "moment_js_tz": $json.dumps(str($moment_js_tz)),
    "moment_js_utc_offset": $moment_js_utc_offset,
    "highcharts_timezoneoffset": $highcharts_timezoneoffset,
    "highcharts_decimal": $json.dumps(str($highcharts_decimal)),
    "highcharts_thousands": $json.dumps(str($highcharts_thousands)),
    "hemisphere": $json.dumps("southern-hemisphere" if "-" in str($station.stn_info.latitude_f) else "northern-hemisphere"),
    "current_datetime_raw": $json.dumps(str($current.dateTime.raw)),
    "almanac_times": $json.dumps($almanac_times),
    "almanac_has_extras": $json.dumps(bool($almanac.hasExtras)),
    "unit_label": {"outTemp": $json.dumps(str($unit.label.outTemp)), "windSpeed": $json.dumps(str($unit.label.windSpeed))},
    "unit_type": {"windSpeed": $json.dumps(str($unit.unit_type.windSpeed))},
    "ordinate_names": $json.dumps([str(x) for x in $ordinate_names]),
    ## This label is a JS object literal in skin.conf, so it is written as code, not text.
    "windDir_ordinals": $obs.label.graphs_windDir_ordinals,
    "radar_html": $json.dumps(str($radar_html)),
    "radar_html_dark": $json.dumps(str($radar_html_dark)),
    "mqtt_websockets_port_kiosk": $json.dumps(str($mqtt_websockets_port_kiosk)),
    "mqtt_websockets_ssl_kiosk": $json.dumps(str($mqtt_websockets_ssl_kiosk)),
    "charts": $charts,
    "graphpage_titles": $graphpage_titles,
    "graphpage_content": $graphpage_content,
    "extras": $json.dumps(dict([(k, $Extras[k]) for k in $js_extras if k in $Extras])),
    "labels": $json.dumps(dict($obs.label))
};
