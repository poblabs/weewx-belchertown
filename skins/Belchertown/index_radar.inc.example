<!-- Copy this file to index_radar.inc to show your radar and a camera picture as two tabs.
     Change the two your_domain/your_photo.jpg addresses to your camera's picture. -->
<div class="radar-tabs">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active"><a href="#radar" aria-controls="radar" role="tab" data-toggle="tab">Radar</a></li>
        <li role="presentation"><a href="#webcam" aria-controls="webcam" role="tab" data-toggle="tab">Station Camera</a></li>
    </ul>
    <div class="tab-content">
        <div id="radar" class="tab-pane active" role="tabpanel">
            <div class="radar_image">$radar_html</div>
        </div>
        <div id="webcam" class="tab-pane" role="tabpanel">
            <a href="https://your_domain/your_photo.jpg" target="_blank"><img src="https://your_domain/your_photo.jpg" alt="Station camera"></a>
        </div>
    </div>
</div>

<script>
// Reload the camera picture every 5 minutes
setInterval(function() {
    document.querySelectorAll("#webcam img").forEach(function(img) {
        img.src = img.getAttribute("src").split("?")[0] + "?" + Date.now();
    });
}, 300000);
</script>

<style>
.radar-tabs .nav-tabs > li > a {
    padding: 0 5px;
}
.dark .radar-tabs .nav-tabs > li.active > a,
.dark .radar-tabs .nav-tabs > li.active > a:focus,
.dark .radar-tabs .nav-tabs > li.active > a:hover {
    color: #e5554e;
}
.radar-tabs img {
    width: 100%;
    height: auto;
}
</style>
